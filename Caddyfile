{
    # Global options
    admin off
}

# Redirect all alternative domains permanently (301) to canonical https://mitkablim.co.il
www.mitkablim.co.il, mitkablim.com, www.mitkablim.com {
    redir https://mitkablim.co.il{uri} 301
}

# Direct HTTP requests for any domain or IP -> 301 straight to canonical HTTPS
http://129.159.158.60, http://mitkablim.com, http://www.mitkablim.com, http://www.mitkablim.co.il {
    redir https://mitkablim.co.il{uri} 301
}

# Primary Canonical Domain (HTTPS with automated Let's Encrypt SSL & HSTS)
mitkablim.co.il {
    header {
        # Strict-Transport-Security (HSTS): enforces HTTPS across all browsers and search engines
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        # Standard security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip zstd
    reverse_proxy kalis:3000
}
