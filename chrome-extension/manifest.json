{
  "manifest_version": 3,
  "name": "מתקבלים — אימות סכם אוטומטי במחשבוני האוניברסיטאות",
  "short_name": "מתקבלים AutoFill",
  "version": "1.2.0",
  "description": "ממלא אוטומטית ציוני בגרות ופסיכומטרי במחשבוני הסכם של 8 האוניברסיטאות בישראל ישירות מתוך אתר מתקבלים",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "מתקבלים — אימות סכם אוטומטי",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.mitkablim.co.il/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.technion.ac.il/*",
    "*://*.tau.ac.il/*",
    "*://go.huji.ac.il/*",
    "*://*.huji.ac.il/*",
    "*://*.bgu.ac.il/*",
    "*://apps4cloud.bgu.ac.il/*",
    "*://*.biu.ac.il/*",
    "*://*.haifa.ac.il/*",
    "*://*.ariel.ac.il/*",
    "*://*.runi.ac.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mitkablim.co.il/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-kalis.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://admissions.technion.ac.il/*",
        "*://*.technion.ac.il/*"
      ],
      "js": [
        "data-guard.js",
        "field-scanner.js",
        "kalis-dock.js",
        "content-technion.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://go.tau.ac.il/*",
        "*://*.tau.ac.il/*"
      ],
      "js": [
        "data-guard.js",
        "field-scanner.js",
        "kalis-dock.js",
        "content-tau.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.bgu.ac.il/*",
        "*://apps4cloud.bgu.ac.il/*"
      ],
      "js": [
        "data-guard.js",
        "field-scanner.js",
        "kalis-dock.js",
        "content-bgu.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://go.huji.ac.il/*",
        "*://*.huji.ac.il/*"
      ],
      "js": [
        "data-guard.js",
        "field-scanner.js",
        "kalis-dock.js",
        "content-huji.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.biu.ac.il/*",
        "*://*.haifa.ac.il/*",
        "*://*.ariel.ac.il/*",
        "*://*.runi.ac.il/*"
      ],
      "js": [
        "data-guard.js",
        "field-scanner.js",
        "kalis-dock.js",
        "content-general.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
